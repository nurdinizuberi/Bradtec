# Environment Variables Template for BRADTEC
# ============================================
# Copy this file to .env and fill in your values
# Place .env one level above public_html on Hostinger
# or inside the data/ folder (blocked from web access)

# Admin Dashboard Password
# This password is used to log in to /admin/
BRADTEC_ADMIN_PASSWORD=YourSecurePassword123!

# Site URL (used for SEO canonicals, Open Graph, schema.org)
# Update this to your actual domain before going live
BRADTEC_SITE_URL=https://your-domain.com
